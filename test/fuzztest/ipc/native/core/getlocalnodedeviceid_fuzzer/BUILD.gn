#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")

SUBSYSTEM_DIR = "//foundation/communication/ipc"

##############################fuzztest##########################################
ohos_fuzztest("GetLocalNodeDeviceIdFuzzTest") {
  module_out_path = "ipc/core"
  fuzz_config_file = "../getlocalnodedeviceid_fuzzer"

  cflags = [
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  sources = [ "getlocalnodedeviceid_fuzzer.cpp" ]

  # RPC 实现已迁出 libipc_single.z.so（见 codespec split-rpc-so），
  # DBinderSoftbusClient 不再由共享库动态导出，故与同目录其他 fuzzer 一致改用静态聚合目标。
  deps = [ "$SUBSYSTEM_DIR/test:ipc_single_test_static" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]
}
