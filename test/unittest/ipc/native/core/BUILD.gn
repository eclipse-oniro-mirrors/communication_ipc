import("//build/test.gni")
import("../../../../../config.gni")

IPC_CORE_ROOT = "$IPC_ROOT_PATH/ipc/native"
MODULE_OUTPUT_PATH = "ipc/ipc/core"

template("ipc_unittest") {
  ohos_unittest(target_name) {
    module_out_path = MODULE_OUTPUT_PATH

    include_dirs = [
      "$IPC_CORE_ROOT/c/rpc/include",
      "$IPC_CORE_ROOT/c/ipc_adapter/include",
      "$IPC_CORE_ROOT/src/core/dbinder/include",
      "$IPC_CORE_ROOT/src/core/framework/include",
      "$IPC_CORE_ROOT/src/core/invoker/include",
      "$IPC_CORE_ROOT/src/core/framework/source",
      "$IPC_ROOT_PATH/interfaces/innerkits/ipc_core/include",
      "$IPC_ROOT_PATH/interfaces/innerkits/libdbinder/include",
      "$IPC_ROOT_PATH/utils/include",
      "$IPC_UNITTEST_ROOT_PATH/mock",
    ]

    if (defined(invoker.include_dirs)) {
      include_dirs += invoker.include_dirs
    }

    configs = [ "$IPC_ROOT_PATH/config:ipc_util_config" ]

    deps = [
      "$IPC_CORE_ROOT/src/core:ipc_common",
      "$IPC_ROOT_PATH/interfaces/innerkits/ipc_single:ipc_single_test",
    ]

    defines = [
      "private = public",
      "protected = public",
    ]

    if (defined(invoker.deps)) {
      deps += invoker.deps
    }

    external_deps = [
      "bounds_checking_function:libsec_shared",
      "c_utils:utils",
      "ffrt:libffrt",
      "googletest:gmock",
      "hilog:libhilog",
      "hitrace:libhitracechain",
      "samgr:samgr_proxy",
    ]

    if (ipc_feature_freeze_enabled) {
      defines += [ "FREEZE_PROCESS_ENABLED" ]
    }

    if (ipc_feature_memory_usage_enabled) {
      defines += ["MEMORY_USAGE_ENABLED"]
    }
    if (ipc_feature_calling_user_info_enabled) {
      defines += ["CALLING_USER_INFO_ENABLED"]
    }

    if (hiviewdfx_hisysevent_support) {
      external_deps += [ "hisysevent:libhisysevent" ]
    }

    if (defined(invoker.external_deps)) {
      external_deps += invoker.external_deps
    }

    sources = invoker.sources
    ldflags = [ "-lpthread" ]
    resource_config_file = "$IPC_ROOT_PATH/test/resource/unittest/ohos_test.xml"
  }
}

ipc_unittest("IPCObjectProxyUnitTest") {
  sources = [ "ipc_object_proxy_unittest.cpp" ]
}

ipc_unittest("IPCProcessSkeletonUnitTest") {
  sources = [ "ipc_process_skeleton_unittest.cpp" ]
}

ipc_unittest("DBinderCallbackStubUnitTest") {
  sources = [ "dbinder_callback_stub_unittest.cpp" ]
}

ipc_unittest("BinderInvokerUnitTest") {
  sources = [ "binder_invoker_unittest.cpp" ]
}

ipc_unittest("DBinderSoftbusClientUnitTest") {
  sources = [ "dbinder_softbus_client_unittest.cpp" ]
}

ipc_unittest("DBinderSoftbusClientAdditionalUnitTest") {
  sources = [ "dbinder_softbus_client_additional_unittest.cpp" ]
}

ipc_unittest("IremoteBrokerUnitTest") {
  sources = [ "iremote_broker_unittest.cpp" ]
}

ipc_unittest("DbinderDataBusInvokerUnitTest") {
  sources = [ "dbinder_databus_invoker_unittest.cpp" ]
}

ipc_unittest("MessageParcelAddUnitTest") {
  sources = [ "message_parcel_unittest.cpp" ]
}

ipc_unittest("IPCSkeletonUnitTest") {
  sources = [ "ipc_skeleton_unittest.cpp" ]
}

ipc_unittest("ProcessSkeletonUnitTest") {
  sources = [ "process_skeleton_unittest.cpp" ]
}

ipc_unittest("IremoteObjectUnitTest") {
  sources = [ "iremote_object_unittest.cpp" ]
}

ipc_unittest("IpcObjectStubUnitTest") {
  sources = [ "ipc_object_stub_unittest.cpp" ]
}

ipc_unittest("IPCThreadSkeletonUnitTest") {
  sources = [ "ipc_thread_skeleton_unittest.cpp" ]
}

ipc_unittest("DatabusSocketListenerUnitTest") {
  sources = [ "databus_socket_listener_unittest.cpp" ]
}

ipc_unittest("IPCFileDescriptorUnitTest") {
  sources = [ "ipc_file_descriptor_unittest.cpp" ]
}

# Keep a unique GN target name here. `test/unittest/common` already defines
# `IPCTraceUnitTest` with the same `ipc_trace.cpp`, which otherwise collides in
# independent-build ninja output generation.
ipc_unittest("IPCTraceNativeCoreUnitTest") {
  sources = [
    "$IPC_CORE_ROOT/src/core/framework/source/ipc_trace.cpp",
    "ipc_trace_unittest.cpp",
  ]
}

ipc_unittest("IPCWorkThreadUnitTest") {
  sources = [ "ipc_workthread_unittest.cpp" ]
}

# Standalone target: it compiles the loader with IPC_RPC_UNIT_TEST and must not
# link ipc_single_test, whose loader copy is built without the test hooks.
ohos_unittest("IpcRpcLoaderUnitTest") {
  module_out_path = MODULE_OUTPUT_PATH

  include_dirs = [ "$IPC_CORE_ROOT/src/core/dbinder/include" ]

  configs = [ "$IPC_ROOT_PATH/config:ipc_util_config" ]

  defines = [ "IPC_RPC_UNIT_TEST" ]

  sources = [
    "$IPC_CORE_ROOT/src/core/dbinder/source/ipc_rpc_loader.cpp",
    "ipc_rpc_loader_unittest.cpp",
  ]

  external_deps = [ "googletest:gmock" ]

  ldflags = [
    "-ldl",
    "-lpthread",
  ]

  resource_config_file = "$IPC_ROOT_PATH/test/resource/unittest/ohos_test.xml"
}

# Closed build shape: ipc_single_test compiles the RPC implementation and the
# entry TU into one image with IPC_RPC_STATIC_LINK, so these cases cover the
# table published by the static loader branch.
ipc_unittest("IpcRpcStaticLinkUnitTest") {
  sources = [ "ipc_rpc_static_link_unittest.cpp" ]
}

# Failure branch of the same static shape. Kept in its own binary because the
# loader caches its first result per process: a successful load cannot be
# followed by a rejected one.
#
# This target defines its own IpcRpcGetOps() and links ipc_rpc_loader.cpp
# directly. It must never depend on ipc_single_test/libipc_single: an ELF
# definition in the executable would preempt the library's provider, the case
# would still pass, and it would no longer test the rejected-table path.
ohos_unittest("IpcRpcStaticLinkFailureUnitTest") {
  module_out_path = MODULE_OUTPUT_PATH

  include_dirs = [
    "$IPC_CORE_ROOT/src/core/dbinder/include",
    "$IPC_ROOT_PATH/utils/include",
  ]

  configs = [ "$IPC_ROOT_PATH/config:ipc_util_config" ]

  defines = [ "IPC_RPC_STATIC_LINK" ]

  sources = [
    "$IPC_CORE_ROOT/src/core/dbinder/source/ipc_rpc_loader.cpp",
    "ipc_rpc_static_link_failure_unittest.cpp",
  ]

  external_deps = [
    "c_utils:utils",
    "googletest:gmock",
    "hilog:libhilog",
  ]

  ldflags = [ "-lpthread" ]

  resource_config_file = "$IPC_ROOT_PATH/test/resource/unittest/ohos_test.xml"
}

###############################################################################
group("ipc_nativecore_unittest") {
  testonly = true
  deps = [
    ":BinderInvokerUnitTest",
    ":DBinderCallbackStubUnitTest",
    ":DBinderSoftbusClientUnitTest",
    ":DBinderSoftbusClientAdditionalUnitTest",
    ":DatabusSocketListenerUnitTest",
    ":DbinderDataBusInvokerUnitTest",
    ":IPCFileDescriptorUnitTest",
    ":IPCObjectProxyUnitTest",
    ":IPCProcessSkeletonUnitTest",
    ":IPCSkeletonUnitTest",
    ":IPCThreadSkeletonUnitTest",
    ":IpcObjectStubUnitTest",
    ":IremoteBrokerUnitTest",
    ":IremoteObjectUnitTest",
    ":MessageParcelAddUnitTest",
    ":ProcessSkeletonUnitTest",
    ":IPCTraceNativeCoreUnitTest",
    ":IPCWorkThreadUnitTest",
    ":IpcRpcLoaderUnitTest",
    ":IpcRpcStaticLinkUnitTest",
    ":IpcRpcStaticLinkFailureUnitTest",
  ]
}
###############################################################################
