RPC_ANI_PATH = "//foundation/communication/ipc/ipc/native/src/ani"
IPC_ROOT_PATH = "//foundation/communication/ipc"
IPC_UNITTEST_ROOT_PATH = "$IPC_ROOT_PATH/test/unittest"
IPC_MODULETEST_ROOT_PATH = "$IPC_ROOT_PATH/test/moduletest"
IPC_FUZZTEST_ROOT_PATH = "$IPC_ROOT_PATH/test/fuzztest"

declare_args() {
  # Ship the DBinder/RPC implementation as a separate libipc_rpc.z.so that
  # libipc_single.z.so loads on first cross-device use. Set to false to build the
  # pre-split shape: the four RPC translation units and the entry TU are compiled
  # into libipc_single.z.so and the loader calls IpcRpcGetOps() directly.
  #
  # Scope of the rollback: it restores the link structure (no companion library,
  # no libipc_rpc DT_NEEDED, no loader dlopen) but not the pre-split export
  # surface. Both shapes share libipc_single_map, so the disabled shape still
  # exports the entries marked "used by libipc_rpc" (245 versus 167 before the
  # split; no entry is lost). The switch also does not cover pre-existing
  # dlopen() calls elsewhere in the component (for example the SoftBus client
  # and the thread pool), which are unchanged by the split.
  ipc_feature_rpc_split_enabled = true
  ipc_feature_rpc_enabled = false
  ipc_feature_test_enabled = false
  ipc_feature_trace_enabled = false
  resourceschedule_ffrt_support = false
  hiviewdfx_backtrace_support = false
  hiviewdfx_hisysevent_support = false
  ipc_proxy_dfx_backtrace_enabled = false
  ipc_feature_freeze_enabled = false
  ipc_feature_memory_usage_enabled = false
  ipc_feature_calling_user_info_enabled = false
}

if (defined(global_parts_info) &&
    defined(global_parts_info.security_access_token)) {
  ipc_feature_test_enabled = true
}

if (defined(global_parts_info) &&
    defined(global_parts_info.resourceschedule_ffrt)) {
  resourceschedule_ffrt_support = true
}

if (defined(global_parts_info) &&
    defined(global_parts_info.hiviewdfx_faultloggerd)) {
  hiviewdfx_backtrace_support = true
}

if (defined(global_parts_info) &&
    defined(global_parts_info.hiviewdfx_hisysevent)) {
  hiviewdfx_hisysevent_support = true
}
